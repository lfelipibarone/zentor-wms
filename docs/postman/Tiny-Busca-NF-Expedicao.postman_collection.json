          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const idNota = Number(pm.collectionVariables.get(\"idNota\"));",
                  "const idPedido = Number(pm.collectionVariables.get(\"idPedido\"));",
                  "const j = pm.response.json();",
                  "const exps = j.expedicoes || [];",
                  "console.log(\"lote\", j.id, \"exps\", exps.length);",
                  "let hit = null;",
                  "exps.forEach((e) => {",
                  "  const nf = e.notaFiscal && e.notaFiscal.id;",
                  "  const ped = e.venda && e.venda.id;",
                  "  const ok = nf === idNota || e.idObjeto === idNota || ped === idPedido;",
                  "  console.log(\" exp\", e.id, \"nf\", nf, \"ped\", ped, ok ? \"<<< MATCH\" : \"\");",
                  "  if (ok) hit = e;",
                  "});",
                  "if (hit) {",
                  "  pm.collectionVariables.set(\"idExpedicao\", String(hit.id));",
                  "  console.log(\"ACHEI — idExpedicao\", hit.id);",
                  "} else {",
                  "  console.log(\"Nao esta neste lote. Mude idAgrupamento ou offset e liste de novo.\");",
                  "}"
                ]
              }
            }
          ]
