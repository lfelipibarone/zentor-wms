DATABASE_URL="postgresql://postgres:admin@localhost:5432/wms?schema=public"
AUTH_SECRET="troque-este-segredo-em-producao"
# Chave AES-256 para tokens OAuth e client_secret (64 hex chars).
# Obrigatória em dev e produção — sem ela, tokens ficam inválidos após restart da API.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""
# URL pública da API (OAuth redirect). Ex.: http://localhost:3333
API_PUBLIC_URL="http://localhost:3333"
# URL do painel web (postMessage OAuth). Ex.: http://localhost:3000
WEB_URL="http://localhost:3000"
# Renova tokens OAuth proativamente a cada 30 min (access ~4h, refresh ~1 dia)
START_OAUTH_REFRESH_WORKER="true"
