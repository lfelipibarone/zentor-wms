{
  "name": "@wms/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "preseed": "pnpm --filter @wms/shared build",
    "db:seed": "tsx prisma/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/services/order-proximity.test.ts src/services/pick-wave-partition.test.ts src/services/tiny-order-priority.test.ts src/services/tiny-integration.test.ts src/services/tiny-sales-order-sync.test.ts src/services/tiny-product-sync.test.ts src/services/tiny-sync-checkpoint.test.ts src/services/demo-tenant-cleanup.test.ts src/services/tiny-oauth.test.ts",
    "tiny:fetch-products": "tsx scripts/fetch-tiny-products.ts",
    "teste-rotas": "tsx scripts/teste-rotas-tiny.ts",
    "teste-pedido": "tsx scripts/teste-pedido-tiny.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@prisma/client": "^6.8.2",
    "@wms/shared": "workspace:*",
    "fastify": "^5.3.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "prisma": "^6.8.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
